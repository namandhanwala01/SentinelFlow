# SentinelFlow AI Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Example: mongodb://localhost:27017/sentinelflow or mongodb+srv://<user>:<password>@cluster.mongodb.net/sentinelflow
MONGODB_URI=mongodb://localhost:27017/sentinelflow

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173

# AI & Simulation Engine Sensitivity (0.0 to 1.0)
AI_FORECAST_SENSITIVITY=0.75
AI_MIN_CONFIDENCE_THRESHOLD=0.60

# Simulator Event Rate (events per interval in live mode)
SIMULATOR_TICK_INTERVAL_MS=3000
