# ==============================================================================
# SentinelFlow AI — Enterprise Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas Cloud Cluster)
# ------------------------------------------------------------------------------
# MongoDB Atlas Setup Sequence:
#   1. Create a free M0 cluster at https://cloud.mongodb.com/
#   2. Create a Database User (Authentication: Password)
#   3. Network Access: Add IP Address (0.0.0.0/0 for cloud / anywhere)
#   4. Get Connection String ("Connect" -> "Drivers" -> Node.js)
#   5. Replace <username> and <password> with your Atlas database credentials:
#
# Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sentinelflow?retryWrites=true&w=majority
#
# Local / Fallback:
MONGODB_URI=mongodb://localhost:27017/sentinelflow

# ------------------------------------------------------------------------------
# 3. Security & CORS Configuration
# ------------------------------------------------------------------------------
# Set to your frontend deployment URL (e.g., https://sentinelflow.vercel.app or http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. AI & Simulation Pipeline Tuning
# ------------------------------------------------------------------------------
AI_FORECAST_SENSITIVITY=0.75
AI_MIN_CONFIDENCE_THRESHOLD=0.60
SIMULATOR_TICK_INTERVAL_MS=3000

# ------------------------------------------------------------------------------
# 5. Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
# Base API URL used by the React client.
# In development with Vite proxy, '/api/v1' or 'http://localhost:5000/api/v1'
VITE_API_BASE_URL=http://localhost:5000/api/v1

